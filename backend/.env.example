# Salin file ini menjadi .env dan isi nilainya
# JANGAN commit file .env ke git

# Server
PORT=3001
NODE_ENV=development

# Database MariaDB / MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portofolio_sekolah
DB_USER=root
DB_PASSWORD=

# JWT
# Ganti dengan string acak yang panjang dan aman di production!
JWT_SECRET=ganti_dengan_secret_yang_kuat_dan_panjang
JWT_EXPIRES_IN=8h

# CORS - pisahkan beberapa origin dengan koma
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
