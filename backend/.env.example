# ============================================================
# Portofolio Sekolah - Konfigurasi Backend (.env)
# Salin file ini menjadi .env lalu sesuaikan jika perlu.
# Pengaturan ini untuk menjalankan backend secara lokal dengan XAMPP.
# ============================================================

# Port server backend
PORT=3001

# Environment: development atau production
NODE_ENV=development

# ── Database MariaDB / MySQL (XAMPP lokal) ──────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=portofolio_sekolah
DB_USER=root
DB_PASSWORD=

# ── JWT ──────────────────────────────────────────────────────
# Untuk development boleh sederhana; ganti dengan secret yang kuat di production!
JWT_SECRET=dev_secret_lokal_boleh_sederhana
JWT_EXPIRES_IN=8h

# ── CORS ─────────────────────────────────────────────────────
# Pisahkan beberapa origin dengan koma
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
